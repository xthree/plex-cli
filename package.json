{
  "name": "plex-cli",
  "version": "0.1.0",
  "description": "Interactive CLI for Plex Media Server",
  "type": "module",
  "bin": {
    "plex-cli": "./bin/plex-cli.cjs"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=tests/"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "conf": "^13.0.0",
    "exceljs": "^4.4.0",
    "inquirer": "^9.2.0",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "axios-mock-adapter": "^1.22.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "moduleResolution": "Bundler",
            "module": "ESNext"
          }
        }
      ]
    },
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
