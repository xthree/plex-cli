{
  "name": "plex-cli",
  "version": "0.1.0",
  "description": "Interactive CLI for Plex Media Server",
  "type": "module",
  "bin": {
    "plex-cli": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "conf": "^13.0.0",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "axios-mock-adapter": "^1.22.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
